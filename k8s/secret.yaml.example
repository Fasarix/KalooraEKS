apiVersion: v1
kind: Secret
metadata:
  name: kaloora-secrets
  namespace: kaloora
type: Opaque
stringData:
  jwt-secret: "CHANGE_ME_JWT_SECRET_MIN_32_CHARACTERS_LONG"
  postgres-host: "CHANGE_ME_RDS_POSTGRES_ENDPOINT"
  postgres-user: "postgres"
  postgres-password: "CHANGE_ME_RDS_PASSWORD"
  postgres-db: "userdb"
  redis-host: "CHANGE_ME_ELASTICACHE_PRIMARY_ENDPOINT"
  redis-auth-token: "CHANGE_ME_REDIS_AUTH_TOKEN_MIN_16_CHARS"
  sqs-queue-url: "https://sqs.us-east-1.amazonaws.com/123456789012/CHANGE_ME_QUEUE_NAME"
  aws-region: "us-east-1"
  dynamodb-diary-table: "kaloora-diary"
  dynamodb-foods-table: "kaloora-foods"
